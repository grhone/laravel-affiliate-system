{
    "name": "grhone/laravel-affiliate-system",
    "description": "Laravel package for an affiliate system",
    "keywords": [
        "grhone",
        "laravel",
        "referral",
        "affiliate",
        "package",
        "laravel-affiliate-system",
        "affiliate-system",
        "user-referral"
    ],
    "homepage": "https://github.com/grhone/laravel-affiliate-system",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gunnar Rhone",
            "email": "me@gunnarrh.one"
        }
    ],
    "require": {
        "php": "^7.2|^7.3|^7.4|^8.0|^8.1|^8.2",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/auth": "^8.0|^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Grhone\\LaravelAffiliateSystem\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grhone\\LaravelAffiliateSystem\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Grhone\\LaravelAffiliateSystem\\Providers\\AffiliateServiceProvider",
                "Grhone\\LaravelAffiliateSystem\\Providers\\TrackingServiceProvider"
            ]
        }
    }
}
